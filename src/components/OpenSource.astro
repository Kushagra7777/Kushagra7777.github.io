---
import Icon from "./Icon.astro";
import { GITHUB_URL } from "../data/site";
const projects = [
  [
    "FlashInfer",
    "Kernel compilation, caching, and execution-path engineering.",
    "01 / LOW-LEVEL INFERENCE",
  ],
  [
    "vLLM",
    "Inference behavior, serving performance, and runtime investigation.",
    "02 / MODEL SERVING",
  ],
  [
    "GPU systems",
    "CUDA, PyTorch, Triton, profiling, benchmarking, and low-level optimization.",
    "03 / THE FOUNDATION",
  ],
];
---

<section class="section container" id="open-source">
  <div class="heading-row reveal">
    <div>
      <p class="eyebrow">04 / OPEN SOURCE, OPEN NOTEBOOK</p>
      <h2>
        Built in public.
        <br />
        <span class="muted">Debugged in detail.</span>
      </h2>
    </div>
    <div>
      <p>
        Long-term hands-on involvement with open-source ML and systems
        engineering. Building, experimenting, and investigating the internals —
        because the source is where the interesting questions lead.
      </p>
      <a
        class="text-link"
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        View GitHub <Icon name="external" size={18} />
      </a>
    </div>
  </div>
  <div class="open-source-grid">
    {projects.map(([title, description, label]) => (
      <article class="open-source-card reveal">
        <span class="mono">{label}</span>
        <h3>{title}</h3>
        <p>{description}</p>
        <span class="source-note mono">AREA OF EXPLORATION</span>
      </article>
    ))}
  </div>
  <!-- Add verified PR links to these cards when available. These are focus areas, not maintainer or contribution claims. -->
</section>
